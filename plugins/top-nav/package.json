{
  "name": "top-nav",
  "version": "0.1.0",
  "description": "Sticky top navigation bar: wordmark, Home/Lexicon/Chapter pills, theme toggle.",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "import": "./src/index.js"
    },
    "./components": {
      "import": "./src/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "sideEffects": false,
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "quartz": {
    "name": "top-nav",
    "displayName": "Top Navigation",
    "category": "component",
    "version": "0.1.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "TopNav": {
        "displayName": "Top Navigation",
        "defaultPosition": "beforeBody",
        "defaultPriority": 1
      }
    }
  }
}
