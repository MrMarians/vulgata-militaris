{
  "name": "vulgata",
  "version": "0.1.0",
  "description": "Site-specific components for Militaria in Vulgata (term legend, lexicon card, local graph).",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "import": "./src/index.js"
    },
    "./components": {
      "import": "./src/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "sideEffects": false,
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "quartz": {
    "name": "vulgata",
    "displayName": "Vulgata Militaris",
    "category": "component",
    "version": "0.1.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "TermLegend": {
        "displayName": "Term Legend",
        "defaultPosition": "beforeBody",
        "defaultPriority": 25
      }
    }
  }
}
